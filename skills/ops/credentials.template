# atlassian-kit credentials. Copy to ~/.claude/atlassian.env and run: chmod 600 ~/.claude/atlassian.env
# Mode 600 is required (the scripts refuse a looser file). Never commit this file or paste a value into chat.
# One value per line, KEY=value, no spaces around "=". Lines starting with # are ignored.

# Site host and account email. Both must match `acli jira auth status`, or every script stops with FATAL.
ACLI_SITE=your-site.atlassian.net
ACLI_EMAIL=you@example.com

# Scoped API token for the Jira app only (one token covers one app; expiry 1-365 days; scopes cannot be edited later).
# Scopes: read:jira-work write:jira-work read:jira-user manage:jira-project read:project:jira read:issue-details:jira
#         read:board-scope:jira-software write:board-scope:jira-software
#         read:board-scope.admin:jira-software write:board-scope.admin:jira-software
# Used by acli-rest-get.py (Jira reads) and every Jira write (jira-call and the hand-written operations).
ACLI_JIRA_TOKEN=

# Scoped API token for the Confluence app only.
# Scopes: read:space:confluence read:page:confluence read:attachment:confluence read:content-details:confluence
#         write:page:confluence write:attachment:confluence delete:page:confluence
# Used by confluence-call (v2), confluence-v1-call (v1), attachment-upload and the `api confluence` reads.
ACLI_CONFLUENCE_TOKEN=

# Token for the acli CLI login itself (unscoped, site-URL token). The zsh acli() wrapper logs acli in again when it changes.
# Not read by the REST scripts.
ACLI_LOGIN_TOKEN=

# Optional per-operation overrides, only when one operation needs a different token or identity. A key set here wins
# over the keys above. Not needed normally; leave them out.
#   ACLI_REST_READ_SITE ACLI_REST_READ_EMAIL ACLI_REST_READ_TOKEN
#   ACLI_REST_WRITE_SITE ACLI_REST_WRITE_EMAIL ACLI_REST_WRITE_JIRA_TOKEN ACLI_REST_WRITE_CONFLUENCE_TOKEN
#   ACLI_REST_WRITE_CONFLUENCE_V1_TOKEN ACLI_REST_WRITE_CONFLUENCE_FILE_TOKEN
